[
  {
    "time": 0.0,
    "text": "\u0938\u0941\u092c\u0939 \u0939\u094b\u0924\u0947 \u0939\u0940 \u0916\u092c\u0930 \u0917\u093e\u0901\u0935\u092d\u0930 \u092b\u0948\u0932 \u0917\u092f\u0940 \u0915\u093f \u090f\u0915 \u092c\u0921\u093c\u093e \u0905\u0928\u0941\u092c\u0902\u0927 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u2014\u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0926\u093f\u0932\u094d\u0932\u0917\u0940 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0906\u0930\u094d\u0925\u093f\u0915 \u0905\u0938\u0930 \u0939\u0941\u0906\u0964"
  },
  {
    "time": 5.18,
    "text": "\u0938\u0940\u0924\u093e \u0915\u094b \u0932\u0917\u093e \u0915\u093f \u0905\u092c \u0938\u092e\u092f \u0906 \u0917\u092f\u093e \u0939\u0948 \u0915\u093f \u092a\u0930\u093f\u0935\u093e\u0930 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e \u0914\u0930 \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0915\u0947 \u092c\u0940\u091a \u091a\u092f\u0928 \u0915\u0930\u0947\u0964"
  },
  {
    "time": 7.22,
    "text": "\u0930\u092e\u0947\u0936 \u092a\u0921\u093c\u094b\u0938\u093f\u092f\u094b\u0902 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0915\u0947 \u0938\u092e\u091d\u094c\u0924\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0948 \u092a\u0930 \u0915\u0941\u091b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0926\u0942\u0930\u0940 \u092c\u0928\u093e \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964"
  },
  {
    "time": 11.04,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0914\u0930 \u0906\u0936\u093e \u092e\u093f\u0932\u0915\u0930 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u094b \u092c\u091a\u093e\u092f\u093e \u091c\u093e\u090f \u0914\u0930 \u0915\u093f\u0938\u0915\u093e \u092d\u0930\u094b\u0938\u093e \u091c\u0940\u0924\u0928\u093e \u0939\u094b\u0917\u093e\u0964"
  },
  {
    "time": 13.6,
    "text": "\u092e\u0940\u0930\u093e \u0916\u0941\u0932\u0915\u0930 \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u092c\u093e\u091c\u093e\u0930 \u092e\u0947\u0902 \u0915\u0941\u091b \u0932\u094b\u0917 \u0907\u0938\u092a\u0930 \u0920\u0939\u093e\u0915\u0947 \u0932\u0917\u093e \u0930\u0939\u0947 \u0925\u0947\u2014\u0915\u093f\u0938\u0940 \u0928\u0947 \u092f\u0939 \u092e\u094c\u0915\u093e \u092b\u093e\u092f\u0926\u093e \u0909\u0920\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u0941\u0928\u093e \u0939\u0948\u0964"
  },
  {
    "time": 18.34,
    "text": "\u0935\u093f\u0915\u094d\u0930\u092e \u0928\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0940 \u0924\u0939\u0915\u0940\u0915\u093e\u0924 \u0915\u0940 \u0914\u0930 \u092a\u093e\u092f\u093e \u0915\u093f \u0905\u0928\u0941\u092c\u0902\u0927 \u092a\u0930 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u092b\u0949\u0930\u094d\u091c\u093c \u0915\u093f\u092f\u0947 \u0917\u090f \u0925\u0947\u2014\u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0937\u0921\u094d\u092f\u0902\u0924\u094d\u0930 \u0925\u093e\u0964"
  },
  {
    "time": 22.18,
    "text": "\u092f\u0939 \u0916\u092c\u0930 \u0918\u0930 \u092e\u0947\u0902 \u0924\u0928\u093e\u0935 \u0914\u0930 \u0905\u0938\u092e\u0902\u091c\u0938 \u092a\u0948\u0926\u093e \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948; \u0938\u0940\u0924\u093e \u0914\u0930 \u092d\u0940 \u0926\u092c\u093e\u0935 \u092c\u0922\u093c\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
  },
  {
    "time": 25.72,
    "text": "\u0930\u093e\u0924 \u092e\u0947\u0902 \u0918\u0930 \u0915\u0947 \u092c\u093e\u0939\u0930 \u090f\u0915 \u0915\u093e\u0932\u0940 \u091d\u094b\u0932\u0940 \u092b\u0947\u0902\u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u0941\u0930\u093e\u0928\u0947 \u0915\u093e\u0917\u091c\u093c, \u090f\u0915 \u092e\u0941\u0939\u0930 \u0914\u0930 \u0915\u0941\u091b \u091a\u0941\u0928\u094d\u0928\u093f\u092f\u093e\u0901 \u0925\u0940\u0902\u2014\u0935\u0939 \u0938\u0902\u0915\u0947\u0924 \u0915\u093f\u0938\u0940 \u092a\u0941\u0930\u093e\u0928\u0947 \u0938\u092e\u094d\u092c\u0928\u094d\u0927 \u0915\u0940 \u0913\u0930 \u0907\u0902\u0917\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
  },
  {
    "time": 28.26,
    "text": "\u0906\u0936\u093e \u0928\u0947 \u091d\u094b\u0932\u0940 \u0909\u0920\u093e\u0915\u0930 \u0926\u0947\u0916\u093e \u0914\u0930 \u0909\u0938\u0915\u0947 \u0939\u093e\u0925 \u0915\u093e\u0901\u092a \u0917\u092f\u0947\u2014\u0935\u093e\u0958\u0908 \u0909\u0938\u092e\u0947\u0902 \u090f\u0915 \u0928\u093e\u092e \u0914\u0930 \u090f\u0915 \u092e\u0941\u0939\u0930 \u0925\u0940 \u091c\u094b \u0938\u0930\u0915\u093e\u0930\u0940 \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0938\u0947 \u092e\u093f\u0932\u0924\u0940 \u0925\u0940\u0964"
  },
  {
    "time": 33.68,
    "text": "\u0930\u092e\u0947\u0936 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0907\u0938\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u092a\u0930 \u0915\u093f\u0938 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0947\u0902\u2014\u092f\u0939 \u092a\u094d\u0930\u0936\u094d\u0928 \u0939\u0935\u093e \u092e\u0947\u0902 \u0909\u0932\u091d \u0917\u092f\u093e\u0964"
  },
  {
    "time": 38.54,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0928\u0947 \u0926\u0943\u0922\u093c\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0915\u0939\u093e \u0915\u093f \u0935\u0947 \u090f\u0915\u091c\u0941\u091f \u0930\u0939\u0947\u0902\u0917\u0947 \u0914\u0930 \u0938\u0924\u094d\u092f \u0938\u093e\u092e\u0928\u0947 \u0932\u093e\u090f\u0901\u0917\u0947, \u092a\u0930 \u092c\u093e\u0939\u0930 \u0915\u093e \u0926\u092c\u093e\u0935 \u0924\u0947\u091c \u0939\u094b\u0924\u093e \u091c\u093e \u0930\u0939\u093e \u0925\u093e\u0964"
  },
  {
    "time": 42.84,
    "text": "\u092c\u093e\u0939\u0930 \u0938\u0947 \u0905\u091a\u093e\u0928\u0915 \u0930\u093e\u0924 \u092e\u0947\u0902 \u0924\u0947\u091c\u093c \u0918\u0902\u091f\u0940 \u092c\u091c\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091c\u094b\u0930 \u0938\u0947 \u0906\u0935\u093e\u091c\u093c \u0926\u0940\u2014\"\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0907\u0938\u0915\u093e \u0939\u093f\u0938\u093e\u092c \u0926\u0947\u0928\u093e \u0939\u094b\u0917\u093e!\"\u2014\u0914\u0930 \u092b\u093f\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091c\u094b\u0930\u0926\u093e\u0930 \u0920\u0939\u093e\u0915\u093e \u092e\u093e\u0930\u093e\u0964"
  }
]