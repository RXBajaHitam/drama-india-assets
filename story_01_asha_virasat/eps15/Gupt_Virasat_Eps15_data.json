[
  {
    "time": 0.0,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u092e\u0928 \u092e\u0947\u0902 \u0938\u0902\u0926\u0947\u0939 \u0915\u0940 \u0932\u0915\u0940\u0930 \u0917\u0939\u0930\u0940 \u0939\u094b\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948\u2014\u0935\u0939 \u0938\u094b\u091a\u0924\u0940 \u0939\u0948 \u0915\u093f \u0915\u0939\u0940\u0902 \u0906\u0936\u093e \u0928\u0947 \u0915\u0941\u091b \u0914\u0930 \u091b\u0941\u092a\u093e \u0930\u0916\u093e \u0939\u0948\u0964"
  },
  {
    "time": 3.46,
    "text": "\u0926\u094b\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u090f\u0915 \u0924\u0940\u0916\u0940 \u092c\u0939\u0938 \u0939\u094b\u0924\u0940 \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u0941\u0930\u093e\u0928\u0947 \u0926\u0930\u094d\u0926 \u0914\u0930 \u0905\u0928\u0915\u0939\u0947 \u0938\u0935\u093e\u0932 \u092c\u093e\u0939\u0930 \u0906 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
  },
  {
    "time": 8.1,
    "text": "\u0938\u0940\u0924\u093e \u0915\u0940 \u092e\u0941\u0938\u094d\u0915\u093e\u0928 \u0905\u092c \u0914\u0930 \u092d\u0940 \u0905\u0927\u093f\u0915 \u0924\u0940\u0915\u094d\u0937\u094d\u0923 \u0914\u0930 \u0928\u093f\u0936\u093e\u0928\u0947 \u092a\u0930 \u0932\u0917\u0940 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948; \u0909\u0938\u0915\u0940 \u091a\u093e\u0932\u093e\u0915\u0940 \u0938\u093e\u092b \u0926\u093f\u0916\u093e\u092f\u0940 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
  },
  {
    "time": 10.84,
    "text": "\u0930\u092e\u0947\u0936 \u091a\u093e\u0939\u0915\u0930 \u092d\u0940 \u0915\u092d\u0940-\u0915\u092d\u0940 \u0932\u093f\u0916\u093f\u0924 \u0938\u093e\u0915\u094d\u0937\u094d\u092f\u094b\u0902 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u0924\u093e \u0914\u0930 \u0935\u0939 \u091a\u0941\u092a\u091a\u093e\u092a \u092a\u0930\u0947\u0936\u093e\u0928 \u0930\u0939\u0924\u093e \u0939\u0948\u0964"
  },
  {
    "time": 15.26,
    "text": "\u0935\u093f\u0915\u094d\u0930\u092e \u0928\u0947 \u0938\u0902\u0915\u0947\u0924 \u0926\u093f\u092f\u093e \u0915\u093f \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0947 \u092c\u0948\u0902\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u0947 \u092a\u093e\u0938 \u0915\u0941\u091b \u0915\u093e\u0917\u091c\u093c \u0939\u0948\u0902 \u091c\u094b \u0907\u0938 \u0915\u0939\u093e\u0928\u0940 \u0915\u094b \u0909\u0932\u091f \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u2014\u092a\u094d\u0930\u093f\u092f\u093e \u0924\u0941\u0930\u0928\u094d\u0924 \u0936\u0939\u0930 \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0924\u0940 \u0939\u0948\u0964"
  },
  {
    "time": 20.24,
    "text": "\u0935\u0939 \u0905\u0915\u0947\u0932\u0947 \u092e\u0947\u0902 \u0909\u0938 \u0928\u093e\u092e \u0915\u0940 \u0924\u0939\u0915\u0940\u0915\u093e\u0924 \u0915\u0930 \u0930\u0939\u0940 \u0925\u0940 \u091c\u094b \u0909\u0938\u0928\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u092e\u0947\u0902 \u0926\u0947\u0916\u093e \u0925\u093e; \u0909\u0938\u0915\u093e \u0926\u093f\u0932 \u0924\u0947\u091c\u0940 \u0938\u0947 \u0927\u0921\u093c\u0915 \u0930\u0939\u093e \u0925\u093e\u0964"
  },
  {
    "time": 23.22,
    "text": "\u0930\u093e\u0924 \u0915\u0947 \u0905\u0901\u0927\u0947\u0930\u0947 \u092e\u0947\u0902 \u091c\u092c \u0935\u0939 \u0939\u094b\u091f\u0932 \u0915\u0947 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0948\u0920\u0915\u0930 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0926\u0947\u0916 \u0930\u0939\u0940 \u0925\u0940, \u0924\u094b \u0905\u091a\u093e\u0928\u0915 \u0932\u093e\u0907\u091f \u091a\u0932\u0940 \u0917\u092f\u0940 \u0914\u0930 \u092b\u094b\u0928 \u0915\u0940 \u0918\u0902\u091f\u0940 \u092c\u091c\u0940\u2014\u092b\u094b\u0928 \u092a\u0930 \u0905\u0928\u091c\u093e\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u0928\u0947 \u0915\u0939\u093e, \"\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0907\u0938\u0915\u094b \u0916\u094b\u0926\u0928\u093e \u0928\u0939\u0940\u0902 \u091a\u093e\u0939\u093f\u090f\"\u0964"
  },
  {
    "time": 28.38,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0921\u0930\u0940 \u0939\u0941\u0908 \u0925\u0940 \u092a\u0930 \u0909\u0938\u0928\u0947 \u0939\u093f\u092e\u094d\u092e\u0924 \u0915\u0930\u0915\u0947 \u0915\u0939\u093e \u0915\u093f \u0935\u0939 \u0938\u091a\u094d\u091a\u093e\u0908 \u091c\u093e\u0928 \u0939\u0940 \u0932\u0947\u0917\u0940; \u0924\u092d\u0940 \u0915\u092e\u0930\u0947 \u0915\u0940 \u0916\u093f\u0921\u093c\u0915\u0940 \u092a\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091c\u094b\u0930 \u0938\u0947 \u0926\u0938\u094d\u0924\u0915 \u0926\u0940 \u0914\u0930 \u092c\u093e\u0939\u0930 \u0938\u0947 \u090f\u0915 \u0928\u0915\u093e\u092c\u092a\u094b\u0936 \u0906\u0935\u093e\u091c\u093c \u0906\u0908\u2014\"\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0930\u094b\u0915 \u0926\u093f\u092f\u093e \u091c\u093e\u092f\u0947\u0917\u093e\"\u2014\u0914\u0930 \u092b\u093f\u0930 \u0905\u0901\u0927\u0947\u0930\u093e \u091f\u0942\u091f \u0917\u092f\u093e\u0964"
  }
]