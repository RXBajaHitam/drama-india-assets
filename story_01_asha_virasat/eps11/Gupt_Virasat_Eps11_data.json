[
  {
    "time": 0.0,
    "text": "\u0916\u0941\u0932\u093e\u0938\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u091a\u0947\u0939\u0930\u0947 \u092c\u0926\u0932 \u0917\u090f\u2014\u0915\u094b\u0908 \u0938\u092e\u0940\u092a \u0906\u0924\u093e \u0939\u0948, \u0915\u094b\u0908 \u0926\u0942\u0930\u0940 \u092c\u0928\u093e\u0915\u0930 \u0916\u0921\u093c\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964"
  },
  {
    "time": 6.9,
    "text": "\u0938\u0940\u0924\u093e \u0905\u092c \u0915\u0908 \u0928\u090f \u0930\u093f\u0936\u094d\u0924\u0947\u0926\u093e\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948; \u0909\u0938\u0915\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0905\u091a\u093e\u0928\u0915 \u0906\u0915\u093e\u0902\u0915\u094d\u0937\u093e\u0913\u0902 \u0938\u0947 \u092d\u0930 \u0917\u092f\u093e \u0925\u093e\u0964"
  },
  {
    "time": 14.96,
    "text": "\u0915\u0941\u091b \u0932\u094b\u0917 \u0909\u092a\u0939\u093e\u0930 \u0914\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0947 \u091d\u0902\u0921\u0947 \u0932\u0947\u0915\u0930 \u0906\u092f\u0947\u2014\u092a\u0930 \u092a\u094d\u0930\u093f\u092f\u093e \u0928\u0947 \u0909\u0928\u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u092e\u0947\u0902 \u0938\u091a\u094d\u091a\u093e\u0908 \u0915\u0940 \u0924\u0932\u093e\u0936 \u0915\u0940\u0964"
  },
  {
    "time": 23.5,
    "text": "\u0935\u093f\u0915\u094d\u0930\u092e \u0928\u0947 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0940 \u0915\u093f \u092c\u093e\u0939\u0930 \u0938\u0947 \u0915\u0941\u091b \u0936\u0915\u094d\u0924\u093f\u092f\u093e\u0901 \u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u0915\u093e \u092b\u093e\u092f\u0926\u093e \u0909\u0920\u093e \u0930\u0939\u0940 \u0939\u0948\u0902; \u0915\u094b\u0908 \u0915\u0947\u0935\u0932 \u0905\u0935\u0938\u0930 \u0915\u0940 \u0924\u0932\u093e\u0936 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964"
  },
  {
    "time": 31.78,
    "text": "\u0906\u0936\u093e \u091a\u0941\u092a \u0925\u0940 \u092a\u0930 \u0909\u0938\u0915\u0940 \u092e\u094c\u0928\u0924\u093e \u092e\u0947\u0902 \u090f\u0915 \u0926\u0943\u0922\u093c \u0907\u0930\u093e\u0926\u093e \u091a\u092e\u0915 \u0930\u0939\u093e \u0925\u093e\u2014\u0935\u0939 \u092f\u0939 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0940 \u0925\u0940 \u0915\u093f \u0909\u0938\u0915\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u092a\u0948\u0938\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
  },
  {
    "time": 36.8,
    "text": "\u0930\u092e\u0947\u0936 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0905\u092c \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u093e\u0928\u0942\u0928\u0940 \u0938\u0932\u093e\u0939 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948, \u092a\u0930 \u0915\u0941\u091b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0932\u0917\u0947 \u0925\u0947\u2014\u092c\u0902\u0926 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0940 \u092c\u0948\u0920\u0915\u094b\u0902 \u092e\u0947\u0902 \u0938\u094c\u0926\u0947 \u0939\u094b \u0930\u0939\u0947 \u0925\u0947\u0964"
  },
  {
    "time": 42.8,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0928\u0947 \u0905\u0902\u0926\u0930 \u0906\u0915\u0930 \u0915\u0939\u093e \u0915\u093f \u0905\u0917\u0930 \u092a\u094d\u0930\u0947\u092e \u0914\u0930 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0915\u0940 \u0915\u0926\u0930 \u0939\u0948 \u0924\u094b \u0927\u0928 \u0915\u093e \u0926\u093f\u0916\u093e\u0935\u093e \u0907\u0938\u092e\u0947\u0902 \u092c\u093e\u0927\u093e \u0928\u0939\u0940\u0902 \u092c\u0928\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"
  },
  {
    "time": 46.78,
    "text": "\u092a\u0930 \u092c\u093e\u0939\u0930 \u0938\u0947 \u0905\u091a\u093e\u0928\u0915 \u090f\u0915 \u092b\u094b\u0928 \u0906\u092f\u093e\u2014\u0915\u0949\u0932 \u092a\u0930 \u090f\u0915 \u0920\u0902\u0921\u0940 \u0906\u0935\u093e\u091c\u093c \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \"\u0939\u092e\u093e\u0930\u0940 \u0915\u0902\u092a\u0928\u0940 \u0915\u0947 \u092f\u0942\u0928\u093f\u091f \u092e\u0947\u0902 \u0914\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0939\u0948\u0902; \u0905\u0917\u0930 \u0906\u092a \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0939\u094b\u0902\u0917\u0947 \u0924\u094b \u0915\u0908 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0916\u0941\u0932\u0947\u0902\u0917\u0947\"\u0964"
  },
  {
    "time": 54.0,
    "text": "\u0932\u094b\u0917 \u0918\u092c\u0930\u093e \u0917\u092f\u0947; \u0915\u0941\u091b \u0928\u0947 \u0921\u0930 \u0926\u093f\u0916\u093e\u092f\u093e \u0914\u0930 \u0915\u0941\u091b \u0928\u0947 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u0928\u0947 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u092f\u0940\u0964"
  },
  {
    "time": 59.5,
    "text": "\u0930\u093e\u0924 \u0915\u094b \u091c\u092c \u0938\u092c \u0938\u094b \u0930\u0939\u0947 \u0925\u0947, \u0924\u094b \u0918\u0930 \u0915\u0940 \u092c\u0948\u0920\u0915\u0940 \u092e\u0947\u0902 \u0905\u091a\u093e\u0928\u0915 \u090f\u0915 \u0905\u091c\u0928\u092c\u0940 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092b\u0947\u0902\u0915 \u0915\u0930 \u092d\u093e\u0917 \u0917\u092f\u093e\u2014\u0909\u0938 \u092a\u0930 \u0915\u0941\u091b \u0928\u093e\u092e \u0914\u0930 \u092a\u0924\u0947 \u0925\u0947 \u091c\u094b \u0935\u093f\u0926\u0947\u0936 \u0938\u0947 \u091c\u0941\u0921\u093c\u0924\u0947 \u0926\u093f\u0916 \u0930\u0939\u0947 \u0925\u0947\u0964"
  },
  {
    "time": 64.94,
    "text": "\u092e\u0940\u0930\u093e \u0928\u0947 \u0909\u0938\u0947 \u0909\u0920\u093e\u092f\u093e \u0914\u0930 \u092c\u094b\u0932\u0940 \u0915\u093f \u092f\u0939 \u0915\u0941\u0932 \u0915\u093e \u0916\u0947\u0932 \u0939\u0948\u2014\u092a\u0930 \u0924\u092d\u0940 \u0916\u093f\u0921\u093c\u0915\u0940 \u0938\u0947 \u090f\u0915 \u0924\u0947\u091c\u093c \u0930\u094b\u0936\u0928\u0940 \u091a\u092e\u0915\u0940 \u0914\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091c\u094b\u0930 \u0915\u0930 \u0915\u0939\u093e\u2014\"\u0924\u0941\u092e \u0938\u092c \u0928\u0939\u0940\u0902 \u0938\u092e\u091d \u092a\u093e\u0913\u0917\u0947, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u092c\u0939\u0941\u0924 \u092c\u0921\u093c\u093e \u0939\u0948\"\u2014\u0914\u0930 \u092b\u093f\u0930 \u0905\u091a\u093e\u0928\u0915 \u0915\u091f\u0964"
  }
]