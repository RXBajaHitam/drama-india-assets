[
  {
    "time": 0.0,
    "text": "\u0906\u0936\u093e \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0905\u092a\u0928\u093e \u0905\u0924\u0940\u0924 \u0916\u094b\u0932\u0924\u0940 \u0939\u0948\u2014\u0935\u0939 \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u092c\u091a\u092a\u0928 \u092e\u0947\u0902 \u0909\u0938\u0947 \u0915\u0948\u0938\u0947 \u0927\u094b\u0916\u093e \u092e\u093f\u0932\u093e \u0914\u0930 \u0909\u0938\u0928\u0947 \u0915\u094d\u092f\u094b\u0902 \u0927\u0928 \u091b\u0941\u092a\u093e\u092f\u093e\u0964"
  },
  {
    "time": 2.86,
    "text": "\u0935\u0939 \u0915\u0939\u0924\u0940 \u0939\u0948 \u0915\u093f \u0909\u0938\u0928\u0947 \u0926\u0947\u0916\u093e \u0925\u093e \u0915\u093f \u0927\u0928 \u0938\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u091f\u0942\u091f\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0938\u0928\u0947 \u0920\u093e\u0928 \u0932\u093f\u092f\u093e \u0915\u093f \u0909\u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0915\u0947\u0935\u0932 \u0927\u0928 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0905\u092a\u0928\u093e\u092f\u093e \u0928 \u091c\u093e\u090f\u0964"
  },
  {
    "time": 8.52,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0909\u0938\u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0938\u0941\u0928\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0938\u0939\u093e\u0928\u0941\u092d\u0942\u0924\u093f \u0909\u0938\u0915\u093e \u092e\u0928 \u092d\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u2014\u0935\u0939 \u0938\u092e\u091d\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u0936\u093e \u0915\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0926\u0930\u094d\u0926 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0925\u093e\u0964"
  },
  {
    "time": 13.72,
    "text": "\u0935\u093f\u0915\u094d\u0930\u092e \u0928\u0947 \u0915\u0908 \u092c\u0948\u0902\u0915 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0914\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0932\u0947\u0928-\u0926\u0947\u0928 \u0907\u0915\u0920\u094d\u0920\u093e \u0915\u093f\u092f\u0947 \u091c\u094b \u0935\u093f\u0926\u0947\u0936\u0940 \u0916\u093e\u0924\u0947 \u0938\u0947 \u091c\u0941\u0921\u093c\u0924\u0947 \u0926\u093f\u0916 \u0930\u0939\u0947 \u0925\u0947\u0964"
  },
  {
    "time": 19.7,
    "text": "\u092a\u0930 \u091c\u0948\u0938\u0947 \u0939\u0940 \u0935\u0947 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u090f\u0915 \u0905\u091c\u094d\u091e\u093e\u0924 \u092b\u093c\u093e\u0907\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0906\u0924\u0940 \u0939\u0948 \u0914\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092e\u0947\u0902 \u0939\u0932\u091a\u0932 \u092e\u091a\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u2014\u0910\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0926\u0942\u0930 \u0938\u0947 \u0921\u0947\u091f\u093e \u091b\u0947\u0921\u093c\u093e \u0939\u0948\u0964"
  },
  {
    "time": 25.78,
    "text": "\u0938\u092d\u0940 \u0915\u093e \u091a\u0947\u0939\u0930\u093e \u0915\u0920\u094b\u0930 \u0939\u094b \u0917\u092f\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0925\u093e \u0915\u093f \u0915\u0947\u0935\u0932 \u0918\u0930\u0947\u0932\u0942 \u0938\u093e\u091c\u093c\u093f\u0936 \u0928\u0939\u0940\u0902, \u092a\u0930 \u092c\u093e\u0939\u0930 \u092d\u0940 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u0925\u093e\u0964"
  },
  {
    "time": 31.8,
    "text": "\u0924\u092d\u0940 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0940 \u091f\u0947\u092a \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092e\u093f\u0932\u0940 \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u0936\u093e \u0915\u0940 \u092c\u091a\u092a\u0928 \u0915\u0940 \u0906\u0939\u091f \u0914\u0930 \u0915\u093f\u0938\u0940 \u0915\u093e \u0928\u093e\u092e \u0925\u093e\u2014\u0935\u0939 \u0928\u093e\u092e \u0935\u093f\u0926\u0947\u0936\u0940 \u0915\u0902\u092a\u0928\u0940 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 \u0925\u093e\u0964"
  },
  {
    "time": 35.94,
    "text": "\u091c\u0948\u0938\u0947 \u0939\u0940 \u0935\u0947 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092a\u094d\u0932\u0947 \u0915\u0930\u0928\u0947 \u0915\u094b \u0924\u0948\u092f\u093e\u0930 \u0939\u0941\u090f, \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092c\u0940\u091a \u092e\u0947\u0902 \u0915\u091f \u0917\u092f\u0940 \u0914\u0930 \u090f\u0915 \u0905\u0928\u091c\u093e\u0928 \u0906\u0935\u093e\u091c\u093c \u092c\u094b\u0932\u0940\u2014\"\u0924\u0941\u092e \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947 \u0915\u093f \u0939\u092e \u0915\u094d\u092f\u093e \u0916\u094b \u0926\u0947\u0902\u0917\u0947 \u0905\u0917\u0930 \u0924\u0941\u092e \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\"\u0964"
  },
  {
    "time": 38.62,
    "text": "\u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u0905\u091a\u093e\u0928\u0915 \u090f\u0915 \u0924\u0947\u091c\u093c \u092c\u094d\u0930\u0947\u0915 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u0908 \u0914\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091a\u093f\u0932\u094d\u0932\u093e\u0915\u0930 \u0915\u0939\u093e \u0915\u093f \"\u0926\u0942\u0924 \u0906 \u0930\u0939\u0947 \u0939\u0948\u0902\"\u2014\u0914\u0930 \u092b\u093f\u0930 \u0938\u092c \u0915\u0941\u091b \u0915\u091f \u0917\u092f\u093e\u0964"
  }
]