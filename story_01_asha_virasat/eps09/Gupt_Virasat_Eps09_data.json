[
  {
    "time": 0.0,
    "text": "\u0938\u0940\u0924\u093e \u0928\u0947 \u0905\u092c \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u094d\u0935\u0930 \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u0906\u0936\u093e \u0928\u0947 \u0915\u0941\u091b \u091b\u0941\u092a\u093e\u092f\u093e \u0939\u0948 \u0914\u0930 \u0935\u0939 \u0938\u092e\u093e\u091c \u0915\u0947 \u0928\u093f\u092f\u092e \u0924\u094b\u0921\u093c \u0930\u0939\u0940 \u0939\u0948\u0964"
  },
  {
    "time": 6.46,
    "text": "\u0909\u0938\u0915\u093e \u0938\u094d\u0935\u0930 \u0924\u0947\u091c\u093c \u0925\u093e \u0914\u0930 \u0939\u0930 \u0936\u092c\u094d\u0926 \u091c\u0948\u0938\u0947 \u0918\u0930 \u0915\u0940 \u0926\u0940\u0935\u093e\u0930\u094b\u0902 \u092a\u0930 \u091a\u094b\u091f \u0915\u0930 \u0930\u0939\u093e \u0939\u094b\u0964"
  },
  {
    "time": 13.08,
    "text": "\u092a\u0930\u093f\u0935\u093e\u0930 \u0926\u094b \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u092e\u0947\u0902 \u092c\u0901\u091f\u0928\u0947 \u0932\u0917\u093e\u2014\u0915\u0941\u091b \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0938\u0940\u0924\u093e \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930 \u0926\u093f\u092f\u093e, \u0915\u0941\u091b \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0906\u0936\u093e \u0915\u0940 \u092c\u0947\u0907\u091c\u093c\u094d\u091c\u093c\u0924\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0928\u0947 \u0926\u0940\u0964"
  },
  {
    "time": 15.18,
    "text": "\u0930\u092e\u0947\u0936 \u0939\u093e\u0925 \u091c\u094b\u0921\u093c\u0915\u0930 \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u092a\u0939\u0932\u0947 \u092c\u093e\u0924 \u0915\u094b \u0920\u0939\u0930 \u0915\u0930 \u091c\u093e\u0901\u091a\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u092a\u0930 \u0909\u0938\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0925\u0915\u093e\u0928 \u0925\u0940\u0964"
  },
  {
    "time": 18.08,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u092e\u0947\u0902 \u091a\u093f\u0902\u0924\u093e \u0914\u0930 \u0918\u092c\u0930\u093e\u0939\u091f \u0926\u094b\u0928\u094b\u0902 \u0938\u093e\u092b \u0926\u093f\u0916 \u0930\u0939\u0947 \u0925\u0947; \u0935\u0939 \u0905\u092a\u0928\u0947 \u092a\u0924\u093f \u0915\u0947 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0914\u0930 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0940 \u0936\u093e\u0902\u0924\u093f \u0915\u0947 \u092c\u0940\u091a \u092b\u0901\u0938\u0940 \u0939\u0941\u0908 \u0925\u0940\u0964"
  },
  {
    "time": 22.28,
    "text": "\u0935\u093f\u0915\u094d\u0930\u092e \u091a\u0941\u092a\u091a\u093e\u092a \u092c\u093e\u0939\u0930 \u0917\u092f\u093e \u0914\u0930 \u0915\u0941\u091b \u092a\u0921\u093c\u094b\u0938\u093f\u092f\u094b\u0902 \u0938\u0947 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0930 \u0932\u094c\u091f\u093e\u2014\u0909\u0938\u0915\u0947 \u091a\u0947\u0939\u0930\u0947 \u092a\u0930 \u092e\u093f\u0932\u0947\u091c\u0941\u0932\u0947 \u0930\u0902\u0917 \u0925\u0947\u0964"
  },
  {
    "time": 26.88,
    "text": "\u092e\u0940\u0930\u093e \u0928\u0947 \u092c\u094b\u0932\u093e \u0915\u093f \u092c\u093e\u091c\u093e\u0930 \u092e\u0947\u0902 \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0905\u0932\u0917 \u092c\u093e\u0924\u0947\u0902 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u090f\u0915 \u0920\u0947\u0915\u0947\u0926\u093e\u0930 \u0928\u0947 \u0905\u0928\u0941\u092c\u0902\u0927 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948\u0964"
  },
  {
    "time": 30.16,
    "text": "\u0928\u090f \u0932\u093f\u092b\u093e\u092b\u093c\u0947 \u0915\u0940 \u0916\u092c\u0930 \u0928\u0947 \u0914\u0930 \u0906\u0917 \u0932\u0917\u093e\u0908\u2014\u090f\u0915 \u0924\u0938\u094d\u0935\u0940\u0930, \u0906\u0927\u0940 \u0927\u0941\u0902\u0927\u0932\u0940, \u0906\u0927\u0940 \u0938\u093e\u092b, \u0914\u0930 \u0928\u0940\u091a\u0947 \u090f\u0915 \u092a\u0924\u093e \u0925\u093e \u091c\u094b \u0939\u0935\u0947\u0932\u0940 \u0915\u0940 \u0913\u0930 \u0907\u0936\u093e\u0930\u093e \u0915\u0930\u0924\u093e \u0925\u093e\u0964"
  },
  {
    "time": 35.06,
    "text": "\u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u0938\u0930\u0938\u0930\u093e\u0939\u091f \u092c\u0922\u093c\u0924\u0940 \u0917\u092f\u0940 \u0914\u0930 \u0926\u093e\u0926\u0940 \u0928\u0947 \u0920\u0902\u0921\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u094b \u092c\u091a\u093e\u0928\u093e \u0939\u094b\u0917\u093e\u0964"
  },
  {
    "time": 40.92,
    "text": "\u092a\u0930 \u092a\u094d\u0930\u093f\u092f\u093e \u0928\u0947 \u0916\u0921\u093c\u0947 \u0939\u094b\u0915\u0930 \u0915\u0939\u093e \u0915\u093f \u0907\u0902\u0938\u093e\u0928\u093f\u092f\u0924 \u0914\u0930 \u092a\u094d\u092f\u093e\u0930 \u0915\u0940 \u092d\u0940 \u0924\u094b \u0915\u0926\u0930 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u2014\u0909\u0938\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0926\u0930\u094d\u0926 \u0925\u093e \u092a\u0930 \u0939\u093f\u092e\u094d\u092e\u0924 \u092d\u0940\u0964"
  },
  {
    "time": 45.6,
    "text": "\u092d\u0940\u0921\u093c \u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0905\u091a\u093e\u0928\u0915 \u0915\u0939\u093e \u0915\u093f \u0939\u0935\u0947\u0932\u0940 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u092d\u0940 \u092e\u093f\u0932 \u091a\u0941\u0915\u093e \u0939\u0948\u2014\u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u0939\u0940 \u0928\u093e\u092e \u092c\u093e\u0930-\u092c\u093e\u0930 \u0906\u0924\u093e \u0925\u093e\u0964"
  },
  {
    "time": 48.38,
    "text": "\u0930\u093e\u0924 \u0928\u0947 \u0905\u0901\u0927\u0947\u0930\u093e \u0917\u0922\u093c \u0932\u093f\u092f\u093e \u0914\u0930 \u0918\u0930 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0938\u0947 \u090f\u0915 \u0924\u0947\u091c\u093c \u0917\u093e\u0921\u093c\u0940 \u0906\u0908\u2014\u0939\u0949\u0930\u094d\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0916\u0941\u0932\u093e \u0914\u0930 \u090f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u0902\u0926\u0930 \u0906\u092f\u093e, \u0909\u0938\u0915\u0947 \u0939\u093e\u0925 \u092e\u0947\u0902 \u090f\u0915 \u092c\u0921\u093c\u093e \u0932\u093f\u092b\u093e\u092b\u093c\u093e \u0925\u093e\u0964"
  },
  {
    "time": 53.1,
    "text": "\u0909\u0938\u0928\u0947 \u0932\u093f\u092b\u093e\u092b\u093c\u093e \u0916\u094b\u0932\u0915\u0930 \u092c\u094b\u0932\u093e \u0915\u093f \u092f\u0939 \u0924\u094b \u0915\u0947\u0935\u0932 \u0936\u0941\u0930\u0941\u0906\u0924 \u0939\u0948 \u0914\u0930 \u092b\u093f\u0930 \u0905\u091a\u093e\u0928\u0915 \u0915\u094b\u0908 \u092c\u093e\u0939\u0930 \u0938\u0947 \u091a\u093f\u0932\u094d\u0932\u093e\u092f\u093e\u2014\"\u0909\u0938 \u0939\u0935\u0947\u0932\u0940 \u0915\u0947 \u0924\u0939\u0916\u093e\u0928\u0947 \u092e\u0947\u0902 \u0915\u0941\u091b \u0910\u0938\u093e \u0939\u0948 \u091c\u094b \u0938\u092c \u092c\u0926\u0932 \u0926\u0947\u0917\u093e...\""
  }
]