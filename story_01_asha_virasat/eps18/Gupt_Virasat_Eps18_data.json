[
  {
    "time": 0.0,
    "text": "\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0916\u0941\u0932\u093e \u0914\u0930 \u092c\u093e\u0939\u0930 \u0916\u0921\u093c\u093e \u0936\u0916\u094d\u0938 \u0905\u092a\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0905\u0902\u0926\u093e\u091c\u093c \u092e\u0947\u0902 \u091d\u0915\u091d\u094b\u0930\u0924\u093e \u0939\u0941\u0906 \u0928\u091c\u0930 \u0906\u092f\u093e\u0964"
  },
  {
    "time": 7.26,
    "text": "\u0909\u0938\u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u092e\u0947\u0902 \u092a\u0941\u0930\u093e\u0928\u0947 \u0939\u093f\u0938\u093e\u092c-\u0915\u093f\u0924\u093e\u092c \u0915\u093e \u0920\u0902\u0921\u093e\u092a\u0928 \u0925\u093e \u0914\u0930 \u0935\u0939 \u0915\u0941\u091b \u0915\u093e\u0917\u091c\u093c \u0925\u093e\u092e\u0947 \u0906\u092f\u093e \u0925\u093e\u0964"
  },
  {
    "time": 13.86,
    "text": "\u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u090f\u0915 \u0915\u094d\u0937\u0923 \u092e\u0947\u0902 \u0909\u0938\u0947 \u092a\u0939\u091a\u093e\u0928 \u0932\u093f\u092f\u093e\u2014\u0935\u0939 \u0935\u0939\u0940 \u0925\u093e \u091c\u093f\u0938\u0928\u0947 \u0915\u092d\u0940 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u0915\u0941\u091b \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u0915\u094b \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0940 \u0925\u0940\u0964"
  },
  {
    "time": 16.96,
    "text": "\u0909\u0938\u0928\u0947 \u0936\u093e\u0902\u0924 \u0938\u094d\u0935\u0930 \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u0935\u0939 \u0935\u093e\u092a\u0938\u0940 \u0907\u0938\u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0906\u092f\u093e \u0915\u093f \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093f\u0932\u093e \u092e\u093f\u091f\u093e \u0932\u0947, \u092c\u0932\u094d\u0915\u093f \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0938\u092e\u092f \u0905\u092c \u0909\u0938\u0915\u093e \u0938\u093e\u0925 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948\u0964"
  },
  {
    "time": 21.98,
    "text": "\u0909\u0938\u0928\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092b\u093e\u0921\u093c \u0915\u0930 \u092a\u0930\u094b\u0938\u0947 \u0914\u0930 \u0915\u0939\u093e \u0915\u093f \u0938\u091a \u0905\u092c \u0926\u092c\u0940 \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u0917\u093e; \u0935\u0939 \u0938\u092c \u0915\u0941\u091b \u0909\u091c\u093e\u0917\u0930 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964"
  },
  {
    "time": 27.2,
    "text": "\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u0915\u0941\u091b \u092a\u0941\u0930\u093e\u0928\u0947 \u0926\u093e\u0935\u0947, \u0915\u0941\u091b \u0926\u0947\u0928\u0926\u093e\u0930\u093f\u092f\u093e\u0901 \u0914\u0930 \u0915\u0941\u091b \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0925\u0947 \u091c\u094b \u0917\u0932\u0924 \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u0915\u094b \u091c\u094b\u0921\u093c\u0924\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u093f\u090f\u0964"
  },
  {
    "time": 31.38,
    "text": "\u0935\u093f\u0915\u094d\u0930\u092e \u0928\u0947 \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u0909\u0928 \u092e\u094b\u0939\u0930\u094b\u0902 \u0914\u0930 \u0928\u093e\u092e\u094b\u0902 \u0915\u0940 \u092a\u0921\u093c\u0924\u093e\u0932 \u0936\u0941\u0930\u0942 \u0915\u0940 \u0914\u0930 \u092a\u093e\u092f\u093e \u0915\u093f \u0915\u0908 \u0915\u0921\u093c\u093f\u092f\u093e\u0901 \u0909\u0938\u0940 \u0935\u093f\u0926\u0947\u0936\u0940 \u0928\u093e\u092e \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0925\u0940\u0902\u0964"
  },
  {
    "time": 36.38,
    "text": "\u0930\u092e\u0947\u0936 \u0915\u093e \u091a\u0947\u0939\u0930\u093e \u0938\u0916\u094d\u0924 \u0939\u094b \u0917\u092f\u093e; \u0935\u0939 \u0938\u092e\u091d \u0917\u092f\u093e \u0915\u093f \u092f\u0939 \u0915\u094b\u0908 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091d\u0917\u0921\u093c\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u092c\u0921\u093c\u0947 \u0916\u0947\u0932 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0925\u093e\u0964"
  },
  {
    "time": 39.52,
    "text": "\u092e\u0940\u0930\u093e \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u0936\u0939\u0930 \u092e\u0947\u0902 \u0915\u0941\u091b \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0907\u0938 \u0928\u093e\u092e \u0938\u0947 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0930\u0924\u0947 \u0938\u0941\u0928\u093e \u0925\u093e \u0914\u0930 \u0935\u0947 \u092d\u092f\u092d\u0940\u0924 \u0926\u093f\u0916\u0947 \u0925\u0947\u0964"
  },
  {
    "time": 41.86,
    "text": "\u092a\u094d\u0930\u093f\u092f\u093e \u0914\u0930 \u0906\u0936\u093e \u0928\u0947 \u092e\u093f\u0932\u0915\u0930 \u0920\u093e\u0928 \u0932\u093f\u092f\u093e \u0915\u093f \u0935\u0947 \u0907\u0938 \u092e\u0915\u0921\u093c\u091c\u093e\u0932 \u0915\u094b \u0916\u094b\u0932\u0947\u0902\u0917\u0947\u2014\u092a\u0930 \u0926\u0941\u0936\u094d\u092e\u0928 \u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0928\u0940 \u0930\u0923\u0928\u0940\u0924\u093f \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0940 \u0925\u0940\u0964"
  },
  {
    "time": 47.76,
    "text": "\u0909\u0938\u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0915\u0941\u091b \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u0920\u0940\u0915 \u0935\u0939\u0940 \u0915\u094b\u0921 \u0925\u093e \u091c\u094b \u092a\u0939\u0932\u0947 \u0917\u093e\u092f\u092c \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092e\u0947\u0902 \u092d\u0940 \u0928\u091c\u093c\u0930 \u0906\u092f\u093e \u0925\u093e \u2014 \u090f\u0915 \u0915\u094b\u0921 \u091c\u094b \u0915\u0908 \u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u092e\u0947\u0902 \u0926\u094b\u0939\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964"
  },
  {
    "time": 56.54,
    "text": "\u0918\u091f\u0928\u093e\u0913\u0902 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908 \u0926\u0947\u0916\u0915\u0930 \u0915\u0941\u091b \u0932\u094b\u0917 \u092d\u093e\u0917\u0928\u0947 \u0932\u0917\u0947 \u092a\u0930 \u0915\u0941\u091b \u0928\u0947 \u0939\u093f\u092e\u094d\u092e\u0924 \u0926\u093f\u0916\u093e\u0908 \u0914\u0930 \u0915\u0939\u093e \u0915\u093f \u0938\u091a\u094d\u091a\u093e\u0908 \u0938\u093e\u092e\u0928\u0947 \u0932\u093e\u0928\u0940 \u0939\u094b\u0917\u0940\u0964"
  },
  {
    "time": 62.68,
    "text": "\u0930\u093e\u0924 \u0915\u0947 \u0938\u092e\u092f \u091c\u092c \u092a\u0930\u093f\u0935\u093e\u0930 \u0928\u0947 \u092e\u093f\u0932\u0915\u0930 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u0908 \u0915\u093f \u0935\u0947 \u0915\u0939\u093e\u0901 \u0938\u0947 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930\u0947\u0902, \u0924\u092c \u0905\u091a\u093e\u0928\u0915 \u092a\u0921\u093c\u094b\u0938 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0927\u092e\u093e\u0915\u093e \u0939\u0941\u0906 \u2014 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0935\u0939\u093e\u0901 \u0935\u093f\u0938\u094d\u092b\u094b\u091f \u091c\u0948\u0938\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0928\u0940\u0964"
  },
  {
    "time": 65.76,
    "text": "\u0932\u094b\u0917 \u0916\u0921\u093c\u0947 \u0939\u094b \u0915\u0930 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0947 \u0914\u0930 \u0926\u0947\u0916\u093e \u0915\u093f \u0917\u093e\u0901\u0935 \u0915\u0940 \u0938\u0940\u092e\u093e \u092a\u0930 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u092c\u0949\u0915\u094d\u0938 \u092c\u093f\u0916\u0930\u093e \u0939\u0941\u0906 \u0925\u093e, \u0909\u0938 \u092c\u0949\u0915\u094d\u0938 \u092a\u0930 \u0935\u0939\u0940 \u0935\u093f\u0926\u0947\u0936\u0940 \u0932\u094b\u0917\u094b \u0909\u092d\u0930\u093e \u0939\u0941\u0906 \u0925\u093e\u2014\u0914\u0930 \u0909\u0938\u0915\u0947 \u090a\u092a\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0916\u0942\u0928 \u0915\u0947 \u0926\u093e\u0917 \u091c\u0948\u0938\u0947 \u0928\u093f\u0936\u093e\u0928 \u091b\u094b\u0921\u093c\u0947 \u0925\u0947\u0964"
  },
  {
    "time": 73.98,
    "text": "\u092e\u0940\u0930\u093e \u0928\u0947 \u0915\u093e\u0901\u092a\u0924\u0947 \u0939\u0941\u090f \u0915\u0939\u093e \u0915\u093f \u092f\u0939 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0939\u0948 \u0914\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0924\u0947\u091c\u0940 \u0938\u0947 \u0915\u0939\u093e \u0915\u093f \"\u0905\u092c \u0924\u0941\u092e \u092a\u0940\u091b\u0947 \u0928\u0939\u0940\u0902 \u0939\u091f \u0938\u0915\u0924\u0947\"\u2014\u092a\u0930 \u0924\u092d\u0940 \u0926\u0942\u0930 \u0938\u0947 \u091a\u094c\u0915\u093f\u092f\u094b\u0902 \u0915\u0940 \u0938\u093e\u092f\u0930\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u0908 \u0914\u0930 \u0905\u0901\u0927\u0947\u0930\u093e \u092b\u0948\u0932 \u0917\u092f\u093e\u0964"
  }
]